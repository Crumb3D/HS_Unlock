	<!-- Extends copies every property except CreativeMode, so each child needs its own. -->
	<append xpath="/blocks/block[@name='powerSwitch02']">
		<property name="CreativeMode" value="Player" />
	</append>
	<append xpath="/blocks/block[starts-with(@name,'pipeSmall') and contains(@name,'Switch') and not(property[@name='CreativeMode'])]">
		<property name="CreativeMode" value="Player" />
	</append>
</configs>
